#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
source /usr/local/lib/eutherboot/common.sh
[[ $(cat /proc/cmdline) == *eutherboot.managed=1* ]] || exit 0
[[ $(cat /proc/cmdline) != *eutherboot.recovery=* ]] || exit 0
version=$(uname -r)
package=$(cat "/usr/lib/modules/$version/pkgbase")
[[ $package == linux || $package == linux-lts ]] || fail 'unmanaged running kernel'
[[ -f $STATE/$package.version && $(cat "$STATE/$package.version") == "$version" ]] || fail 'running and published versions differ'
check_esp inspect
sha256sum "$ESP_MOUNT/EFI/EutherBoot/kernels/$package.efi" | cut -d' ' -f1 > "$STATE/$package.confirmed.new"
mv "$STATE/$package.confirmed.new" "$STATE/$package.confirmed"
sync -f "$STATE"
echo "EUTHERBOOT_CONFIRMED $package $version"
