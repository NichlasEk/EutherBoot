#!/usr/bin/env bash
set -euo pipefail
work="$HOME/work"
if mountpoint -q /mnt/rescue-data; then work=/mnt/rescue-data/work; fi
mkdir -p "$work"
checkout="$work/EutherBoot-0.1.2"
if [[ ! -d "$checkout" ]]; then
    cp -r /usr/local/share/euther-rescue/EutherBoot "$checkout"
    chmod -R u+w "$checkout"
fi
cd "$checkout"
printf '\nArbetsmapp: %s\n' "$PWD"
printf 'Codex kräver internet och inloggning. Vid behov: codex login --device-auth\n'
printf 'Läs /usr/local/share/euther-rescue/RESCUE.md för offlinehjälp.\n\n'
printf 'Debian-installation: läs /usr/local/share/euther-rescue/INSTALL-DEBIAN.md\n\n'
exec codex "$@"
